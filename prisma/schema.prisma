generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AuthTokenKind {
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum ReleaseType {
  ALBUM
  EP
  SINGLE
}

enum AudioCodec {
  MP3
  AAC
  FLAC
}

/**
 * Qué se sabe de la letra de una pista.
 *
 * `MISSING` no es la ausencia de fila: es la respuesta guardada de que el
 * proveedor no la tiene. Distinguirlas es lo que evita volver a preguntar por
 * la misma canción en cada reproducción.
 */
enum LyricStatus {
  SYNCED
  PLAIN
  INSTRUMENTAL
  MISSING
}

model User {
  id              String             @id @default(uuid()) @db.Uuid
  /// La dirección tal y como la escribió el usuario. Es la que se le muestra.
  email           String             @unique
  /// Forma canónica, para comparar buzones: Gmail ignora puntos y `+etiqueta`.
  /// Es la que decide si una cuenta ya existe, y el índice único lo garantiza
  /// aunque alguna vía futura olvide comprobarlo.
  emailKey        String             @unique
  passwordHash    String?
  displayName     String
  avatarUrl       String?
  role            Role               @default(USER)
  /// Cuándo se comprobó que el buzón existe. Nulo mientras no se verifique.
  emailVerifiedAt DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  authTokens      AuthToken[]
  playlists     Playlist[]
  favourites    Favourite[]
  followed      ArtistFollow[]
  savedAlbums   AlbumSave[]
  history       ListeningHistory[]
  preferences   UserPreference?
  refreshTokens RefreshToken[]
}

model Artist {
  id        String         @id @default(uuid()) @db.Uuid
  slug      String         @unique
  name      String
  bio       String?
  photoUrl  String?
  genres    String[]
  albums    Album[]
  tracks    Track[]
  followers ArtistFollow[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Album {
  id        String      @id @default(uuid()) @db.Uuid
  slug      String      @unique
  artistId  String      @db.Uuid
  artist    Artist      @relation(fields: [artistId], references: [id], onDelete: Cascade)
  title     String
  year      Int
  type      ReleaseType @default(ALBUM)
  genre     String
  coverUrl  String
  accent    String?
  tracks    Track[]
  savedBy   AlbumSave[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([artistId, year])
}

model Track {
  id             String             @id @default(uuid()) @db.Uuid
  slug           String             @unique
  artistId       String             @db.Uuid
  artist         Artist             @relation(fields: [artistId], references: [id], onDelete: Cascade)
  albumId        String             @db.Uuid
  album          Album              @relation(fields: [albumId], references: [id], onDelete: Cascade)
  title          String
  duration       Int
  genre          String
  explicit       Boolean            @default(false)
  codec          AudioCodec
  coverUrl       String?
  storageKey     String             @unique
  fileSizeBytes  BigInt
  isPublished    Boolean            @default(false)
  favourites     Favourite[]
  playlistTracks PlaylistTrack[]
  moodTracks     MoodTrack[]
  history        ListeningHistory[]
  lyric          Lyric?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([albumId])
  @@index([artistId])
  @@index([title])
}

/**
 * La letra de una pista, ya consultada.
 *
 * El proveedor es LRCLIB, gratuito y sin clave, pero preguntarle desde cada
 * cliente tenía dos costes: la misma pregunta se repetía por dispositivo y por
 * recarga —la web solo cacheaba en memoria—, y la app móvil no podía tener
 * letras sin reimplementar el proveedor entero. Preguntando aquí, se pregunta
 * una vez y responden los dos clientes igual.
 *
 * `trackId` es la clave primaria y no hay `id` propio: una pista tiene una
 * letra o no la tiene, y la relación 1-1 lo deja dicho en el esquema en lugar
 * de confiarlo a un índice único que alguien podría quitar.
 */
model Lyric {
  trackId String      @id @db.Uuid
  track   Track       @relation(fields: [trackId], references: [id], onDelete: Cascade)
  status  LyricStatus

  /// LRC con marcas de tiempo, tal y como llegó. Nulo si solo hay texto plano.
  syncedText String?
  /// Texto sin sincronizar. Se guarda aunque haya `syncedText`, porque es el
  /// recambio si algún día el LRC resulta ilegible.
  plainText  String?

  /// De dónde salió. Existe para poder sustituir una letra a mano más adelante
  /// sin que el refresco automático la pise.
  source String @default("lrclib")

  /// Cuándo se preguntó. Un `MISSING` caduca y se vuelve a intentar; una letra
  /// encontrada no, porque no va a dejar de existir.
  fetchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, fetchedAt])
}

/**
 * Playlist de un usuario o del propio Pulse.
 *
 * `ownerId` es opcional porque las editoriales no son de nadie: vivían escritas
 * en el código del cliente y por eso no se podían editar sin desplegar. Una
 * playlist de sistema es exactamente eso, una sin dueño y con `isSystem`.
 */
model Playlist {
  id            String          @id @default(uuid()) @db.Uuid
  ownerId       String?         @db.Uuid
  owner         User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  isSystem      Boolean         @default(false)
  title         String
  description   String?
  coverUrl      String?
  collaborative Boolean         @default(false)
  isPublic      Boolean         @default(false)
  position      Int             @default(0)
  tracks        PlaylistTrack[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([ownerId, updatedAt])
  @@index([isSystem, position])
}

/**
 * Género musical con su color de presentación.
 *
 * El color vivía en el cliente, así que añadir un género obligaba a tocar dos
 * sitios. Aquí solo están los géneros que de verdad aparecen en el catálogo.
 */
model Genre {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String   @unique
  color     String
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

/** Selección temática hecha a mano: "Concentración", "Viajar"… */
model Mood {
  id          String      @id @default(uuid()) @db.Uuid
  slug        String      @unique
  name        String
  description String?
  icon        String
  color       String
  position    Int         @default(0)
  tracks      MoodTrack[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([position])
}

model MoodTrack {
  moodId   String @db.Uuid
  trackId  String @db.Uuid
  position Int
  mood     Mood   @relation(fields: [moodId], references: [id], onDelete: Cascade)
  track    Track  @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([moodId, trackId])
  @@unique([moodId, position])
}

model PlaylistTrack {
  playlistId String   @db.Uuid
  trackId    String   @db.Uuid
  position   Int
  addedById  String?  @db.Uuid
  addedAt    DateTime @default(now())
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([playlistId, trackId])
  @@unique([playlistId, position])
}

model Favourite {
  userId    String   @db.Uuid
  trackId   String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@id([userId, trackId])
}

/**
 * Álbum guardado en la biblioteca.
 *
 * Faltaba: `Favourite` cubre pistas y `ArtistFollow` artistas, pero los discos
 * guardados solo existían en el navegador y por eso no seguían a nadie de un
 * dispositivo a otro.
 */
model AlbumSave {
  userId    String   @db.Uuid
  albumId   String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  album     Album    @relation(fields: [albumId], references: [id], onDelete: Cascade)

  @@id([userId, albumId])
}

model ArtistFollow {
  userId    String   @db.Uuid
  artistId  String   @db.Uuid
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  artist    Artist   @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@id([userId, artistId])
}

model ListeningHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  trackId   String   @db.Uuid
  source    String?
  progress  Int      @default(0)
  completed Boolean  @default(false)
  playedAt  DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  track     Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@index([userId, playedAt(sort: Desc)])
}

model UserPreference {
  userId          String   @id @db.Uuid
  theme           String   @default("dark")
  language        String   @default("es")
  streamQuality   String   @default("high")
  downloadQuality String   @default("high")
  autoplay        Boolean  @default(true)
  crossfade       Int      @default(0)
  normalize       Boolean  @default(false)
  privateSession  Boolean  @default(false)
  /// Géneros que el usuario marca como suyos. Vivían en el navegador, así que
  /// no le acompañaban de un dispositivo a otro.
  favouriteGenres String[]
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/**
 * Enlace de un solo uso enviado por correo.
 *
 * Sirve tanto para restablecer la contraseña como para comprobar el buzón. Se
 * guarda su huella, nunca el valor: quien lea esta tabla no puede reconstruir
 * un enlace válido, igual que con los refresh tokens.
 */
model AuthToken {
  id        String        @id @default(uuid()) @db.Uuid
  userId    String        @db.Uuid
  kind      AuthTokenKind
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@index([userId])
}
