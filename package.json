{
  "name": "pulse-api",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "dev": "nest start --watch",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "import": "tsx scripts/import-manifest.ts",
    "create-admin": "tsx scripts/create-admin.ts",
    "seed:editorial": "tsx scripts/seed-editorial.ts",
    "classify:genres": "tsx scripts/classify-genres.ts",
    "openapi": "nest build && node dist/scripts/generate-openapi.js",
    "openapi:check": "nest build && node dist/scripts/generate-openapi.js --check"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.0",
    "@fastify/multipart": "9.2.1",
    "@fastify/static": "^10.1.3",
    "@nestjs/common": "11.1.29",
    "@nestjs/core": "11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-fastify": "11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "^6.5.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "17.4.2",
    "fastify": "5.11.0",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/node": "24.3.0",
    "prisma": "7.9.1",
    "tsx": "^4.23.12",
    "typescript": "5.9.2",
    "yaml": "^2.9.0"
  }
}
