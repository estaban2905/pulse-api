PORT=4000
PUBLIC_API_URL=http://localhost:4000/v1
DATABASE_URL=postgresql://pulse:pulse@localhost:5432/pulse?schema=public
# Firma de sesiones. Dos secretos distintos y de al menos 32 caracteres: el API
# no arranca si falta alguno, si son cortos o si coinciden entre sí.
# Genera cada uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-character-secret

# Firma de las URLs de audio. Un `<audio src>` no puede mandar cabeceras, así
# que el permiso para reproducir viaja dentro de la URL y caduca a las 24 h.
# Cambiar este secreto invalida al instante todos los enlaces ya repartidos.
MEDIA_SIGNING_SECRET=replace-with-another-32-plus-character-secret

# Orígenes autorizados a llamar al API con credenciales, separados por comas.
# Sin lista blanca no hay cookie de sesión que valga: dejarlo abierto permitiría
# a cualquier web hacer peticiones autenticadas en nombre de quien la visite.
# En desarrollo puede quedar vacío: cualquier puerto de localhost o 127.0.0.1
# se acepta igualmente. En producción es obligatorio y no hay red de seguridad.
CORS_ORIGINS=

# `lax` mientras web y API compartan dominio (o sean dos puertos de localhost).
# `none` si están en proveedores distintos; entonces la cookie exige HTTPS.
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.pulse.app

PULSE_ADMIN_TOKEN=replace-with-a-long-random-admin-token
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pulse-media
S3_ACCESS_KEY=pulse
S3_SECRET_KEY=change-me
